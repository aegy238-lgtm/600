# Server-side Admin Dashboard password (overrides first-run setup password when set)
ADMIN_DASHBOARD_PASSWORD=

# Comma-separated external origins allowed to call /api/* (e.g. standalone Admin Dashboard URL)
# Example: CORS_ORIGINS="https://admin.example.com,https://game.example.com"
CORS_ORIGINS=

# Server database filename stored inside ./data/ (default: teen-patti-db.json)
DATABASE_FILE="teen-patti-db.json"

# Optional frontend deployment mode: "all" (default), "game" (game only), or "admin" (standalone dashboard)
VITE_APP_MODE="all"

# Optional external Game Server URL when hosting the Admin Dashboard on a separate domain
# Example: VITE_API_BASE_URL="https://api.example.com"
VITE_API_BASE_URL=
